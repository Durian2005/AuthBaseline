{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "https://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "allow-get-backend-url",
    "allow-otp-compute"
  ]
}
