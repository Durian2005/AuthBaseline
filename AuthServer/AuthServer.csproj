<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 发布产物落在项目目录内的 publish/（npm run publish:backend 的 -o 参数），
       而 Sdk.Web 默认把项目目录下 **/* 收作 Content，会把上一次的 publish/ 再复制
       进这一次的产物里，层层嵌套出 publish/publish/publish。
       这里显式排除，让发布目录只反映当前源码。 -->
  <ItemGroup>
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="2.25.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- DPAPI（ProtectedData）：.NET Core 起被移出 BCL，须显式引用。
         仅 Windows 可用 —— 本项目发布目标即 win-x64，无跨平台顾虑。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
